<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copyright 2026ff novatechflow (Alexander Alten)
  SPDX-License-Identifier: PolyForm-Shield-1.0.0

  Template LaunchAgent for the polyDisplay server.
  Do not use directly - run ./install.sh, which fills in __BIN__/__DIR__
  with real paths and installs this to ~/Library/LaunchAgents/.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.novatechflow.polydisplay</string>
  <!--
    Launched under `caffeinate` so the Mac won't system-sleep while the server
    is running - including with the lid closed. -s holds off sleep on AC power;
    -i also covers idle sleep. When on battery the Mac still sleeps normally.
    caffeinate runs __BIN__ as its child and drops the assertion when it exits.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-s</string>
    <string>-i</string>
    <string>__BIN__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__DIR__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__DIR__/polydisplay.log</string>
  <key>StandardErrorPath</key>
  <string>__DIR__/polydisplay.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- optional: paste a free CoinGecko demo key for higher rate limits -->
    <key>CG_DEMO_KEY</key>
    <string></string>
  </dict>
</dict>
</plist>
